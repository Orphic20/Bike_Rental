# Copy to `.env` and fill in. Vite only exposes variables prefixed with VITE_.

# Base URL of the FastAPI service. Must be an origin listed in the backend's
# CORS_ORIGINS, otherwise the browser blocks every request.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project settings → API. The anon key is safe to ship to the browser;
# the backend independently verifies every token against the project's JWKS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Without a key the landing page shows the illustrated map fallback.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
